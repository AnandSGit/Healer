{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AnandSGit/Healer/schema/flow.schema.json",
  "title": "Healer Flow Preset Catalog Entry",
  "description": "Schema for entries in data/flows.yaml — drives /healer:flow <preset> ? drill-down",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^[a-z][a-z0-9-]*$": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "what_it_does",
        "input",
        "steps",
        "example",
        "input_purpose",
        "after"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        },
        "what_it_does": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syntax"],
          "properties": {
            "syntax": { "type": "string" },
            "args": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "desc", "required"],
                "properties": {
                  "name": { "type": "string" },
                  "desc": { "type": "string" },
                  "required": { "type": "boolean" }
                }
              }
            },
            "valid": { "type": "array", "items": { "type": "string" } },
            "invalid": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["text", "why"],
                "properties": {
                  "text": { "type": "string" },
                  "why": { "type": "string" }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "gate"],
            "properties": {
              "command": { "type": "string" },
              "gate": {
                "enum": ["auto", "interactive", "must-pass"]
              },
              "args": { "type": "string" },
              "produces": { "type": "string" }
            }
          }
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "trace", "why_this_example"],
          "properties": {
            "command": { "type": "string" },
            "trace": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 2
            },
            "why_this_example": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "input_purpose": {
          "type": "string",
          "minLength": 20
        },
        "after": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "next": {
              "type": "array",
              "items": { "type": "string" }
            },
            "sister_presets": {
              "type": "array",
              "items": { "type": "string" }
            },
            "on_failure": { "type": "string" }
          }
        }
      }
    }
  }
}
